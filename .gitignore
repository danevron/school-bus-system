# See http://help.github.com/ignore-files/ for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# ============================================================================
# NODE.JS / NPM
# ============================================================================

# Ignore node_modules directories
/node_modules
/backend/node_modules
/frontend/node_modules

# NPM debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ============================================================================
# BUILD DIRECTORIES
# ============================================================================

# Backend build output
/backend/dist
/backend/build

# Frontend build output
/frontend/dist
/frontend/build

# Root level builds (if any)
/dist
/build

# ============================================================================
# ENVIRONMENT FILES
# ============================================================================

# Root level environment files
/.env
/.env.local
/.env.development
/.env.production
/.env.test

# Backend environment files
/backend/.env
/backend/.env.local
/backend/.env.development
/backend/.env.production
/backend/.env.test

# Frontend environment files
/frontend/.env
/frontend/.env.local
/frontend/.env.development
/frontend/.env.production
/frontend/.env.test

# ============================================================================
# FLUTTER / MOBILE
# ============================================================================

# Note: The mobile/ directory has its own .gitignore file
# These are additional monorepo-level patterns

# Flutter build artifacts at root level
/mobile/build/

# Generated files that might be created outside mobile dir
flutter_*.log
.flutter-plugins*
.packages

# Mobile development artifacts
/mobile/*.iml

# ============================================================================
# IDE / EDITOR FILES
# ============================================================================

# Visual Studio Code
.vscode/

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Android Studio
.gradle/
local.properties

# Xcode
*.xcscmblueprint
*.xccheckout
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# ============================================================================
# OPERATING SYSTEM FILES
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ============================================================================
# LOGS
# ============================================================================

# Log files
*.log
/logs
/backend/logs
/frontend/logs

# Flutter logs
flutter_*.log

# ============================================================================
# TEMPORARY FILES
# ============================================================================

# Temporary directories
/tmp
/temp
.cache

# ============================================================================
# TESTING
# ============================================================================

# Test coverage
/coverage
/backend/coverage
/frontend/coverage
/mobile/coverage/
*.lcov

# Flutter test results
/mobile/test_results/

# ============================================================================
# MISCELLANEOUS
# ============================================================================

# Lock files (optional - some teams prefer to commit these)
# package-lock.json
# yarn.lock
# Note: pubspec.lock should generally be committed for applications

# Local development files
.local

# Backup files
*.backup
*.bak
*~

# Archive files (often created during development)
*.tar
*.tar.gz
*.zip
*.rar