{
  "name": "school-bus-system",
  "version": "1.0.0",
  "description": "School Bus Ride Management System - Monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ..",
    "clean:all": "rm -rf node_modules backend/node_modules frontend/node_modules backend/dist mobile/build",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:mobile": "cd mobile && flutter run",
    "start": "cd backend && npm start",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run preview",
    "build": "npm run build:backend && npm run build:frontend",
    "build:deploy": "npm run install:all && npm run build:frontend && npm run build:backend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:mobile": "cd mobile && flutter build apk --release",
    "build:mobile:ios": "cd mobile && flutter build ios --no-codesign",
    "build:mobile:android": "cd mobile && flutter build apk --release",
    "test": "npm run test:backend && npm run test:mobile",
    "test:backend": "cd backend && npm test",
    "test:mobile": "cd mobile && flutter test",
    "analyze:mobile": "cd mobile && flutter analyze",
    "seed": "cd backend && npm run seed",
    "lint": "echo 'Linting not configured yet'",
    "format": "echo 'Formatting not configured yet'"
  },
  "keywords": [
    "school-bus",
    "transportation",
    "management",
    "monorepo",
    "flutter",
    "vue",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}