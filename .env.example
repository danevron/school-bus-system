# School Bus System - Environment Variables
# Copy this to .env and fill in your values

# Server Configuration
NODE_ENV=production
PORT=10000

# Database
MONGODB_URI=mongodb://localhost:27017/school-bus-system

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# CORS Configuration
ALLOWED_ORIGINS=https://your-app-name.onrender.com,http://localhost:3000,http://localhost:5173

# Optional: Logging
LOG_LEVEL=info

# Optional: Database Options
DB_POOL_SIZE=10
DB_TIMEOUT=30000